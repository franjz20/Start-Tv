# Backend port (Railway assigns PORT automatically)
PORT=3001

# TMDB API key - get yours at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# Comma-separated list of allowed frontend origins
# Production example: https://your-app.vercel.app
# Include Capacitor origins for the mobile app: capacitor://localhost,https://localhost
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Rate limit: max requests per 15 minutes per IP
RATE_LIMIT_MAX=100

# SQLite database path
# Northflank: create a Volume, mount it, and set DATABASE_PATH to the mount path
# (e.g. /data/starttv.db) so watch progress persists between deploys.
# DATABASE_PATH=/data/starttv.db
